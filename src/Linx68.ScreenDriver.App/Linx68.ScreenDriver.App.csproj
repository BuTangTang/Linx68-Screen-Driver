<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Title>灵犀68屏幕驱动</Title>
    <AssemblyTitle>灵犀68屏幕驱动</AssemblyTitle>
    <Product>灵犀68屏幕驱动</Product>
    <Description>Windows screen manager for Linx68 keyboards.</Description>
    <Company>butang</Company>
    <Authors>butang</Authors>
    <Copyright>Original work Copyright © 2026 ZCat95; modifications Copyright © 2026 butang</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Linx68.ScreenDriver.Application\Linx68.ScreenDriver.Application.csproj" />
    <ProjectReference Include="..\Linx68.ScreenDriver.Core\Linx68.ScreenDriver.Core.csproj" />
    <ProjectReference Include="..\Linx68.ScreenDriver.Infrastructure\Linx68.ScreenDriver.Infrastructure.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Fonts\README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\PRIVACY.md" Link="PRIVACY.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\ASSET_LICENSE.md" Link="ASSET_LICENSE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Legal\dotnet-LICENSE.txt" Link="Licenses\dotnet-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Legal\dotnet-ThirdPartyNotices.txt" Link="Licenses\dotnet-ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Legal\WebView2-LICENSE.txt" Link="Licenses\WebView2-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Legal\WebView2-NOTICE.txt" Link="Licenses\WebView2-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Linx68.ScreenDriver.Core\Assets\Fonts\Doto-OFL.txt" Link="Licenses\Doto-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\TrayIcon.ico" />
    <Resource Include="Assets\TrayIcon.White.ico" />
  </ItemGroup>
</Project>
