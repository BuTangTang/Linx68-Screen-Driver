<Window x:Class="Linx68.ScreenDriver.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Linx68.ScreenDriver.App"
        Title="灵犀68屏幕驱动"
        Icon="pack://application:,,,/Linx68.ScreenDriver.App;component/Assets/AppIcon.png"
        Width="1280" Height="800" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="False"
        Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="-1" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowRoot" Background="{DynamicResource AppBackground}" CornerRadius="{StaticResource Radius.Window}" BorderBrush="{DynamicResource Stroke.Default}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource AppBackground}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Image Width="20" Height="20" Source="pack://application:,,,/Linx68.ScreenDriver.App;component/Assets/AppIcon.png" Margin="0,0,10,0" />
                    <TextBlock Text="灵犀68屏幕驱动" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TitleBarForeground}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleBarButton}" ToolTip="最小化" Click="MinimizeButton_OnClick">
                        <Path Width="12" Height="12" Data="M 1,6 L 11,6" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                    </Button>
                    <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleBarButton}" ToolTip="最大化或还原" Click="MaximizeButton_OnClick">
                        <Grid Width="12" Height="12">
                            <Rectangle Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Rectangle Width="8" Height="8" Margin="0,3,3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" />
                                <Rectangle Width="8" Height="8" Margin="3,0,0,3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource CloseTitleBarButton}" ToolTip="关闭" Click="CloseButton_OnClick">
                        <Path Width="12" Height="12" Data="M 1.5,1.5 L 10.5,10.5 M 10.5,1.5 L 1.5,10.5" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                    </Button>
                </StackPanel>
                <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource HairlineBrush}" />
            </Grid>

            <Grid x:Name="WorkspaceLayout" Grid.Row="1" Margin="18,0,18,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="196" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,10,0,0" Background="{DynamicResource Surface.Sidebar}" CornerRadius="{StaticResource Radius.Window}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" ClipToBounds="True">
                    <Grid x:Name="SidebarShell">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Margin="16,16,16,0">
                            <TextBlock Text="灵犀68屏幕驱动" FontSize="21" FontWeight="Bold" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Ellipse x:Name="DeviceStatusDot" Width="9" Height="9" Fill="{DynamicResource DangerBrush}" Margin="0,0,8,0" />
                                <TextBlock x:Name="DeviceStatusText" Text="设备离线" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="SidebarNavigationPanel" Grid.Row="1" Margin="8,22,8,0">
                            <RadioButton x:Name="ScreenNav" GroupName="Navigation" Content="显示方案" Style="{StaticResource SideNavRadio}" Tag="screen" Checked="Navigation_OnChecked" IsChecked="{Binding IsScreenPage, Mode=OneWay}" />
                            <RadioButton x:Name="AutomationNav" GroupName="Navigation" Content="自动化" Style="{StaticResource SideNavRadio}" Tag="automation" Checked="Navigation_OnChecked" IsChecked="{Binding IsAutomationPage, Mode=OneWay}" />
                            <RadioButton x:Name="ThemeNav" GroupName="Navigation" Content="外观" Style="{StaticResource SideNavRadio}" Tag="appearance" Checked="Navigation_OnChecked" IsChecked="{Binding IsAppearancePage, Mode=OneWay}" />
                            <RadioButton x:Name="SettingsNav" GroupName="Navigation" Content="其他设置" Style="{StaticResource SideNavRadio}" Tag="settings" Checked="Navigation_OnChecked" IsChecked="{Binding IsSettingsPage, Mode=OneWay}" />
                            <RadioButton x:Name="AboutNav" GroupName="Navigation" Content="关于" Style="{StaticResource SideNavRadio}" Tag="about" Checked="Navigation_OnChecked" IsChecked="{Binding IsAboutPage, Mode=OneWay}" />
                        </StackPanel>

                        <Button x:Name="EndpointShortcutButton" Grid.Row="2" Style="{StaticResource SidebarEndpointButton}" Click="EndpointShortcutButton_OnClick" ToolTip="点击设置设备地址">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="设备地址" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" />
                                    <TextBlock x:Name="EndpointSummaryText" Text="地址未配置" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="设置 ›" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource Surface.Window}" CornerRadius="{StaticResource Radius.Window}" Margin="0,10,0,0" Padding="24,20">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="PageTitleText" Text="{Binding PageTitle}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock x:Name="PageSubtitleText" Text="{Binding PageSubtitle}" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button x:Name="LocateCurrentButton" Grid.Column="1" Content="定位当前" Style="{StaticResource CompactSecondaryButton}" VerticalAlignment="Center" Click="LocateCurrent_OnClick" Visibility="{Binding IsScreenPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>

                        <Grid x:Name="ContentLayout" Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="288" /></Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="ThemeScrollViewer" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" FocusVisualStyle="{x:Null}" KeyboardNavigation.IsTabStop="False" SizeChanged="ThemeScrollViewer_OnSizeChanged">
                                <Grid>
                                    <Grid x:Name="ScreenPanel" Width="{Binding ViewportWidth, ElementName=ThemeScrollViewer}" Visibility="{Binding IsScreenPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="142" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel x:Name="ThemeCategoryNavigation" VerticalAlignment="Top">
                                            <TextBlock Text="方案分类" FontSize="12" FontWeight="SemiBold" Margin="8,4,8,12" />
                                            <RadioButton Tag="all" GroupName="ThemeCategory" Style="{StaticResource ThemeCategoryRadio}" Checked="ThemeCategory_OnChecked" IsChecked="{Binding Screen.IsAllCategorySelected, Mode=OneWay}">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="全部方案" /><TextBlock Grid.Column="1" Text="{Binding Screen.AllThemeCount}" Foreground="{DynamicResource SecondaryText}" /></Grid>
                                            </RadioButton>
                                            <ItemsControl x:Name="ThemeCategoryPanel" ItemsSource="{Binding Screen.ThemeGroups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <RadioButton Tag="{Binding Id}" GroupName="ThemeCategory" Style="{StaticResource ThemeCategoryRadio}" Checked="ThemeCategory_OnChecked" IsChecked="{Binding IsSelected, Mode=OneWay}">
                                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding Themes.Count}" Foreground="{DynamicResource SecondaryText}" /></Grid>
                                                        </RadioButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <Grid Grid.Column="2" x:Name="ThemeLibraryPanel">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Screen.VisibleThemeCountText}" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,12" />
                                            <ItemsControl x:Name="ThemeGalleryPanel" Grid.Row="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Screen.VisibleThemes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <RadioButton GroupName="Theme" Style="{StaticResource ThemeGalleryCard}"
                                                                     Width="{Binding CardWidth}" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Description}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryText}" />
                                                            </StackPanel>
                                                        </RadioButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                        <StackPanel x:Name="CurrentConfigPanel" Visibility="Collapsed">
                                        <Border Style="{StaticResource SectionCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="当前显示方案" FontSize="12" Foreground="{DynamicResource SecondaryText}" />
                                                    <TextBlock x:Name="CurrentThemeNameText" Text="电脑状态" FontSize="22" FontWeight="SemiBold" Margin="0,9,0,0" />
                                                    <TextBlock x:Name="CurrentThemeDescription" Text="显示 CPU、内存与网络状态" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,9,0,0" />
                                                </StackPanel>
                                                <Button x:Name="SelectImageButton" Grid.Column="1" Content="选择图片" Style="{StaticResource SecondaryButton}" Click="ChooseImageButton_OnClick" Visibility="Collapsed" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SectionCard}">
                                            <StackPanel>
                                                <TextBlock Text="画面内容" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock x:Name="CurrentThemeDetailsText" Text="CPU 使用率、内存占用、实时下载和上传速率。" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,9,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel x:Name="ContextDataPanel">
                                        <Border x:Name="SystemDataCard" Style="{StaticResource SectionCard}" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="电脑状态" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="由 Windows 原生接口采集，不需要后台服务。" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,7,0,14" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="CpuValueText" Text="CPU —" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="MemoryValueText" Grid.Column="1" Text="内存 —" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="DownloadValueText" Grid.Column="2" Text="下载 —" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="UploadValueText" Grid.Column="3" Text="上传 —" FontWeight="SemiBold" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="MusicDataCard" Style="{StaticResource SectionCard}" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="Windows 媒体会话" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="读取当前媒体封面、曲名、歌手与播放进度；动态主题可选同步歌词。" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,7,0,14" />
                                                <TextBlock x:Name="MusicSourceText" Text="当前没有可用的 Windows 媒体会话" FontSize="12" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                                                <Grid Margin="0,16,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="在线同步歌词" FontSize="13" FontWeight="SemiBold" />
                                                        <TextBlock Text="启用后仅向 LRCLIB 发送曲名、歌手和时长。" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,0" />
                                                    </StackPanel>
                                                    <CheckBox x:Name="OnlineLyricsCheckBox" Grid.Column="1" Content="启用" VerticalAlignment="Center"
                                                              Checked="SettingToggle_OnChanged" Unchecked="SettingToggle_OnChanged" />
                                                </Grid>
                                                <Grid Margin="0,16,0,0" IsEnabled="{Binding IsChecked, ElementName=OnlineLyricsCheckBox}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="歌词时间偏移" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Slider x:Name="LyricOffsetSlider" Grid.Column="1" Minimum="-3" Maximum="3" Value="0"
                                                            TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                            ValueChanged="LyricOffsetSlider_OnValueChanged" />
                                                    <TextBlock x:Name="LyricOffsetValueText" Grid.Column="2" Text="+0.0 秒" FontSize="11"
                                                               Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="AiQuotaDataCard" Style="{StaticResource SectionCard}" Visibility="Collapsed">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="AI 用量数据源（测试版）" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="AiSourceStatusText" Grid.Column="1" Text="尚未连接"
                                                               FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                                               VerticalAlignment="Center" Margin="16,0,0,0" />
                                                </Grid>
                                                <TextBlock x:Name="AiSourceDescriptionText" Text="选择用于 AI 用量主题的数据源。"
                                                           FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                                           Margin="0,7,0,16" TextWrapping="Wrap" />

                                                <Border Style="{StaticResource InlineSurface}" Padding="16,12" Margin="0,0,0,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="320" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="数据源" FontSize="13" FontWeight="SemiBold" />
                                                            <TextBlock Text="不同平台的登录资料不会互相迁移" FontSize="11"
                                                                       Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                        <ComboBox x:Name="AiSourceComboBox" Grid.Column="1" SelectedValuePath="Tag"
                                                                  SelectionChanged="AiSourceComboBox_OnSelectionChanged">
                                                            <ComboBoxItem Tag="MiMo" Content="小米 MiMo 额度" />
                                                            <ComboBoxItem Tag="Codex" Content="OpenAI Codex 额度" />
                                                        </ComboBox>
                                                    </Grid>
                                                </Border>

                                                <Border Style="{StaticResource InlineSurface}" Padding="16,12" Margin="0,0,0,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="320" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="屏幕显示名称" FontSize="13" FontWeight="SemiBold" />
                                                            <TextBlock Text="建议不超过 12 个字符" FontSize="11"
                                                                       Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                        <TextBox x:Name="AiDisplayNameTextBox" Grid.Column="1" Text="MiMo" MaxLength="18"
                                                                 VerticalAlignment="Center" TextChanged="SettingTextBox_OnTextChanged" />
                                                    </Grid>
                                                </Border>

                                                <Border Style="{StaticResource InlineSurface}" Padding="16">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.05*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="1*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="1.1*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="剩余额度" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                                                <TextBlock x:Name="MiMoRemainingValueText" Text="—" FontSize="24"
                                                                           FontWeight="SemiBold" Margin="0,4,0,0" />
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Width="1" Background="{DynamicResource Stroke.Default}" Margin="18,2" />
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="已使用 / 总额" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                                                <TextBlock x:Name="MiMoCreditsValueText" Text="—" FontSize="15"
                                                                           FontWeight="SemiBold" Margin="0,6,0,0" />
                                                            </StackPanel>
                                                            <Border Grid.Column="3" Width="1" Background="{DynamicResource Stroke.Default}" Margin="18,2" />
                                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                                <TextBlock Text="本期截止" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                                                <TextBlock x:Name="MiMoExpiryValueText" Text="—" FontSize="15"
                                                                           FontWeight="SemiBold" Margin="0,6,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <ProgressBar x:Name="MiMoRemainingProgress" Height="4" Minimum="0" Maximum="100"
                                                                     Value="0" Margin="0,14,0,0" Foreground="{DynamicResource AccentBrush}"
                                                                     Background="{DynamicResource Surface.Pressed}" BorderThickness="0">
                                                            <ProgressBar.Template>
                                                                <ControlTemplate TargetType="ProgressBar">
                                                                    <Grid ClipToBounds="True">
                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                                                                        <Border x:Name="PART_Track" />
                                                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                                                                HorizontalAlignment="Left" CornerRadius="2" />
                                                                    </Grid>
                                                                </ControlTemplate>
                                                            </ProgressBar.Template>
                                                        </ProgressBar>
                                                    </StackPanel>
                                                </Border>

                                                <StackPanel x:Name="MiMoActionsPanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                                    <Button Content="登录小米控制台" MinWidth="138" Click="MiMoLoginButton_OnClick" />
                                                    <Button Content="立即刷新" Style="{StaticResource SecondaryButton}"
                                                            MinWidth="104" Margin="8,0,0,0" Click="MiMoRefreshButton_OnClick" />
                                                </StackPanel>
                                                <WrapPanel x:Name="CodexActionsPanel" HorizontalAlignment="Right" Margin="0,12,0,0" Visibility="Collapsed">
                                                    <Button Content="安装/更新 Codex" MinWidth="126" Click="CodexInstallButton_OnClick" />
                                                    <Button Content="登录 Codex" MinWidth="104" Margin="8,0,0,8" Click="CodexLoginButton_OnClick" />
                                                    <Button Content="检查状态" Style="{StaticResource SecondaryButton}" MinWidth="92" Margin="8,0,0,8" Click="CodexStatusButton_OnClick" />
                                                    <Button Content="打开配置" Style="{StaticResource SecondaryButton}" MinWidth="92" Margin="8,0,0,8" Click="CodexOpenConfigButton_OnClick" />
                                                    <Button Content="导出配置" Style="{StaticResource SecondaryButton}" MinWidth="92" Margin="8,0,0,8" Click="CodexExportConfigButton_OnClick" />
                                                    <Button Content="导入配置" Style="{StaticResource SecondaryButton}" MinWidth="92" Margin="8,0,0,8" Click="CodexImportConfigButton_OnClick" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="WeatherDataCard" Style="{StaticResource SectionCard}" Visibility="Collapsed">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="天气" FontSize="16" FontWeight="SemiBold" />
                                                        <TextBlock Text="自动定位使用 Windows 位置服务；不可用时回退到手动城市。"
                                                                   FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,7,0,0" />
                                                    </StackPanel>
                                                    <CheckBox x:Name="WeatherAutomaticLocationCheckBox" Grid.Column="1" Content="自动定位"
                                                              VerticalAlignment="Center"
                                                              Checked="WeatherAutomaticLocationCheckBox_OnChanged"
                                                              Unchecked="WeatherAutomaticLocationCheckBox_OnChanged" />
                                                </Grid>
                                                <Grid Margin="0,14,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="手动城市" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBox x:Name="WeatherLocationTextBox" Grid.Column="1" Text="北京" MaxLength="40"
                                                             Height="44" VerticalContentAlignment="Center"
                                                             ToolTip="自动定位关闭或不可用时使用，例如：北京、上海、深圳"
                                                             TextChanged="SettingTextBox_OnTextChanged" />
                                                </Grid>
                                                <TextBlock Text="天气由 Open-Meteo 提供；自动定位城市名由 BigDataCloud 解析。"
                                                           FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,12,0,0" />
                                                <TextBlock x:Name="WeatherSourceStatusText" Text="等待获取天气数据"
                                                           FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="StockDataCard" Style="{StaticResource SectionCard}" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="股票（测试版）" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="最多添加三项。代码示例：AAPL、0700.HK、600519.SS、000001.SZ、BTC-USD。数据可能延迟或不准确，不构成投资建议。"
                                                           FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,7,0,14" TextWrapping="Wrap" />
                                                <Grid Margin="0,0,0,6">
