<Window x:Class="Linx68.ScreenDriver.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Linx68.ScreenDriver.App"
        Title="灵犀68屏幕驱动"
        Icon="pack://application:,,,/Linx68.ScreenDriver.App;component/Assets/AppIcon.png"
        Width="1280" Height="800" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="False"
        Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate x:Key="DataSourceStatusCardTemplate">
            <Border Style="{StaticResource SectionCard}" Padding="16" Margin="0,0,10,0" MinHeight="128">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
					<Border x:Name="DataStateRail" Grid.RowSpan="4" Width="3" HorizontalAlignment="Left" CornerRadius="1.5">
						<Border.Style>
							<Style TargetType="Border">
								<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding State}" Value="Ready"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
									<DataTrigger Binding="{Binding State}" Value="Empty"><Setter Property="Background" Value="{DynamicResource DangerBrush}" /></DataTrigger>
									<DataTrigger Binding="{Binding State}" Value="Stale"><Setter Property="Background" Value="{DynamicResource WarningBrush}" /></DataTrigger>
									<DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Background" Value="{DynamicResource DangerBrush}" /></DataTrigger>
								</Style.Triggers>
							</Style>
						</Border.Style>
					</Border>
                    <Grid Margin="11,0,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                        <Border x:Name="DataStateBadge" Grid.Column="1" CornerRadius="10" Padding="8,3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Ready"><Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" /></DataTrigger>
										<DataTrigger Binding="{Binding State}" Value="Empty"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Stale"><Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock x:Name="DataStateBadgeText" Text="{Binding StateLabel}" FontSize="10" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Ready"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
											<DataTrigger Binding="{Binding State}" Value="Empty"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Stale"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Summary}" ToolTip="{Binding Summary}" FontSize="13" FontWeight="SemiBold" Margin="11,10,0,0" TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Row="2" Margin="11,5,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Detail}" ToolTip="{Binding Detail}" FontSize="10" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" />
						<TextBlock Grid.Column="1" Text="{Binding Timing}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{DynamicResource SecondaryText}" Margin="8,0,0,0" />
                    </Grid>
					<TextBlock Grid.Row="3" Text="{Binding Source}" ToolTip="{Binding Source}" FontSize="9" Foreground="{DynamicResource SecondaryText}" Opacity="0.82" Margin="11,4,0,0" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="-1" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowRoot" Background="{DynamicResource AppBackground}" CornerRadius="{StaticResource Radius.Window}" BorderBrush="{DynamicResource Stroke.Default}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource AppBackground}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Image Width="20" Height="20" Source="pack://application:,,,/Linx68.ScreenDriver.App;component/Assets/AppIcon.png" Margin="0,0,10,0" />
                    <TextBlock Text="灵犀68屏幕驱动" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TitleBarForeground}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleBarButton}" ToolTip="最小化" Click="MinimizeButton_OnClick">
                        <Path Width="12" Height="12" Data="M 1,6 L 11,6" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                    </Button>
                    <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleBarButton}" ToolTip="最大化或还原" Click="MaximizeButton_OnClick">
                        <Grid Width="12" Height="12">
                            <Rectangle Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Rectangle Width="8" Height="8" Margin="0,3,3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" />
                                <Rectangle Width="8" Height="8" Margin="3,0,0,3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource CloseTitleBarButton}" ToolTip="关闭" Click="CloseButton_OnClick">
                        <Path Width="12" Height="12" Data="M 1.5,1.5 L 10.5,10.5 M 10.5,1.5 L 1.5,10.5" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                    </Button>
                </StackPanel>
                <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource HairlineBrush}" />
            </Grid>

            <Grid x:Name="WorkspaceLayout" Grid.Row="1" Margin="18,0,18,18">
				<Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,10,0,0" Background="{DynamicResource Surface.Sidebar}" CornerRadius="{StaticResource Radius.Window}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" ClipToBounds="True">
                    <Grid x:Name="SidebarShell">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Margin="16,16,16,0">
                            <TextBlock Text="灵犀68屏幕驱动" FontSize="21" FontWeight="Bold" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Ellipse x:Name="DeviceStatusDot" Width="9" Height="9" Fill="{DynamicResource SecondaryText}" Margin="0,0,8,0" />
                                <TextBlock x:Name="DeviceStatusText" Text="设备未配置" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="SidebarNavigationPanel" Grid.Row="1" Margin="8,22,8,0">
                            <RadioButton x:Name="ScreenNav" GroupName="Navigation" Content="显示方案" Style="{StaticResource SideNavRadio}" Tag="screen" Checked="Navigation_OnChecked" IsChecked="{Binding IsScreenPage, Mode=OneWay}" />
                            <RadioButton x:Name="DataServicesNav" GroupName="Navigation" Content="数据服务" Style="{StaticResource SideNavRadio}" Tag="dataServices" Checked="Navigation_OnChecked" IsChecked="{Binding IsDataServicesPage, Mode=OneWay}" />
                            <RadioButton x:Name="AutomationNav" GroupName="Navigation" Content="自动化" Style="{StaticResource SideNavRadio}" Tag="automation" Checked="Navigation_OnChecked" IsChecked="{Binding IsAutomationPage, Mode=OneWay}" />
                            <RadioButton x:Name="ThemeNav" GroupName="Navigation" Content="外观" Style="{StaticResource SideNavRadio}" Tag="appearance" Checked="Navigation_OnChecked" IsChecked="{Binding IsAppearancePage, Mode=OneWay}" />
                            <RadioButton x:Name="SettingsNav" GroupName="Navigation" Content="其他设置" Style="{StaticResource SideNavRadio}" Tag="settings" Checked="Navigation_OnChecked" IsChecked="{Binding IsSettingsPage, Mode=OneWay}" />
                            <RadioButton x:Name="AboutNav" GroupName="Navigation" Content="关于" Style="{StaticResource SideNavRadio}" Tag="about" Checked="Navigation_OnChecked" IsChecked="{Binding IsAboutPage, Mode=OneWay}" />
                        </StackPanel>

                        <Button x:Name="EndpointShortcutButton" Grid.Row="2" Style="{StaticResource SidebarEndpointButton}" Click="EndpointShortcutButton_OnClick" ToolTip="点击设置设备地址">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="设备地址" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" />
                                    <TextBlock x:Name="EndpointSummaryText" Text="地址未配置" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="设置 ›" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

				<Border Grid.Column="2" Background="{DynamicResource WindowAmbientBrush}" CornerRadius="{StaticResource Radius.Window}" Margin="0,10,0,0" Padding="24,20">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="PageTitleText" Text="{Binding PageTitle}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock x:Name="PageSubtitleText" Text="{Binding PageSubtitle}" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderRefreshTimingText" Text="" FontSize="11" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button x:Name="RefreshAllDataButton" Content="刷新全部" Style="{StaticResource CompactSecondaryButton}" Click="RefreshAllDataButton_OnClick" Visibility="{Binding IsDataServicesPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button x:Name="RunAutomationNowButton" Content="立即执行" Style="{StaticResource CompactSecondaryButton}" Click="RunAutomationNowButton_OnClick" Visibility="{Binding IsAutomationPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button x:Name="RefreshScreenDataButton" Content="刷新数据" Style="{StaticResource CompactSecondaryButton}" Click="RefreshScreenDataButton_OnClick" Visibility="{Binding IsScreenPage, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,8,0" />
                                <Button x:Name="LocateCurrentButton" Content="定位当前" Style="{StaticResource CompactSecondaryButton}" Click="LocateCurrent_OnClick" Visibility="{Binding IsScreenPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ContentLayout" Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="ThemeScrollViewer" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" FocusVisualStyle="{x:Null}" KeyboardNavigation.IsTabStop="False" SizeChanged="ThemeScrollViewer_OnSizeChanged">
                                <Grid>
                                    <Grid x:Name="ScreenPanel" Width="{Binding ViewportWidth, ElementName=ThemeScrollViewer}" Visibility="{Binding IsScreenPage, Converter={StaticResource BooleanToVisibilityConverter}}">
										<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel x:Name="ThemeCategoryNavigation" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,14">
											<RadioButton Tag="all" GroupName="ThemeCategory" Style="{StaticResource ThemeCategoryRadio}" Command="{Binding Screen.SelectCategoryCommand}" CommandParameter="all" IsChecked="{Binding Screen.IsAllCategorySelected, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="全部" /><TextBlock Text="{Binding Screen.AllThemeCount, StringFormat={}  {0}}" Foreground="{DynamicResource SecondaryText}" /></StackPanel>
                                            </RadioButton>
                                            <ItemsControl x:Name="ThemeCategoryPanel" ItemsSource="{Binding Screen.ThemeGroups}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
													<RadioButton Tag="{Binding Id}" GroupName="ThemeCategory" Style="{StaticResource ThemeCategoryRadio}" Command="{Binding DataContext.Screen.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" IsChecked="{Binding IsSelected, Mode=OneWay}">
                                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DisplayName}" /><TextBlock Text="{Binding Themes.Count, StringFormat={}  {0}}" Foreground="{DynamicResource SecondaryText}" /></StackPanel>
                                                        </RadioButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <Grid Grid.Row="1" x:Name="ThemeLibraryPanel">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Screen.VisibleThemeCountText}" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,12" />
                                            <ItemsControl x:Name="ThemeGalleryPanel" Grid.Row="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Screen.VisibleThemes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <RadioButton GroupName="Theme" Style="{StaticResource ThemeGalleryCard}"
                                                                     Width="{Binding CardWidth}" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" MaxHeight="32" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryText}" />
                                                                <Border Background="{DynamicResource Surface.Control}" BorderBrush="{DynamicResource Stroke.Default}" BorderThickness="1" CornerRadius="7" Padding="7,3" Margin="0,9,0,0" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding Metadata}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" />
                                                                </Border>
                                                            </StackPanel>
                                                        </RadioButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                        <StackPanel x:Name="CurrentConfigPanel" Grid.Row="2" Visibility="Collapsed">
                                        <Border Style="{StaticResource SectionCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="当前显示方案" FontSize="12" Foreground="{DynamicResource SecondaryText}" />
                                                    <TextBlock x:Name="CurrentThemeNameText" Text="电脑状态" FontSize="22" FontWeight="SemiBold" Margin="0,9,0,0" />
                                                    <TextBlock x:Name="CurrentThemeDescription" Text="显示 CPU、内存与网络状态" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,9,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SectionCard}">
                                            <StackPanel>
                                                <TextBlock Text="画面内容" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock x:Name="CurrentThemeDetailsText" Text="CPU 使用率、内存占用、实时下载和上传速率。" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,9,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel x:Name="ContextDataPanel">
                                        <Border x:Name="SystemDataCard" Style="{StaticResource SectionCard}" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="电脑状态" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="由 Windows 原生接口采集，不需要后台服务。" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,7,0,14" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="CpuValueText" Text="CPU —" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="MemoryValueText" Grid.Column="1" Text="内存 —" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="DownloadValueText" Grid.Column="2" Text="下载 —" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="UploadValueText" Grid.Column="3" Text="上传 —" FontWeight="SemiBold" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="MusicDataCard" Style="{StaticResource SectionCard}" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="Windows 媒体会话" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="读取当前媒体封面、曲名、歌手与播放进度；动态主题可选同步歌词。" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,7,0,14" />
                                                <TextBlock x:Name="MusicSourceText" Text="当前没有可用的 Windows 媒体会话" FontSize="12" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                                                <Grid Margin="0,16,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="在线同步歌词" FontSize="13" FontWeight="SemiBold" />
                                                        <TextBlock Text="启用后仅向 LRCLIB 发送曲名、歌手和时长。" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,0" />
                                                    </StackPanel>
                                                    <CheckBox x:Name="OnlineLyricsCheckBox" Grid.Column="1" Content="启用" VerticalAlignment="Center"
                                                              Checked="SettingToggle_OnChanged" Unchecked="SettingToggle_OnChanged" />
                                                </Grid>
                                                <Grid Margin="0,16,0,0" IsEnabled="{Binding IsChecked, ElementName=OnlineLyricsCheckBox}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="歌词时间偏移" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Slider x:Name="LyricOffsetSlider" Grid.Column="1" Minimum="-3" Maximum="3" Value="0"
                                                            TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                            ValueChanged="LyricOffsetSlider_OnValueChanged" />
                                                    <TextBlock x:Name="LyricOffsetValueText" Grid.Column="2" Text="+0.0 秒" FontSize="11"
                                                               Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="AiQuotaDataCard" Style="{StaticResource SectionCard}" Visibility="Collapsed">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Codex 额度" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="AiSourceStatusText" Grid.Column="1" Text="尚未连接"
                                                               FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                                               VerticalAlignment="Center" Margin="16,0,0,0" />
                                                </Grid>
                                                <TextBlock Text="通过本机 Codex App Server 读取额度窗口与下次重置时间。身份认证仍由 Codex 管理，本应用不会读取、复制或导出 auth.json。"
                                                           FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                                           Margin="0,7,0,16" TextWrapping="Wrap" />

                                                <Border Style="{StaticResource InlineSurface}" Padding="16">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.05*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="1*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="1.1*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="当前窗口剩余" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                                                <TextBlock x:Name="CodexRemainingValueText" Text="—" FontSize="24"
                                                                           FontWeight="SemiBold" Margin="0,4,0,0" />
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Width="1" Background="{DynamicResource Stroke.Default}" Margin="18,2" />
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="当前窗口已用" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                                                <TextBlock x:Name="CodexCreditsValueText" Text="—" FontSize="15"
                                                                           FontWeight="SemiBold" Margin="0,6,0,0" />
                                                            </StackPanel>
                                                            <Border Grid.Column="3" Width="1" Background="{DynamicResource Stroke.Default}" Margin="18,2" />
                                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                                <TextBlock Text="下次重置" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                                                <TextBlock x:Name="CodexExpiryValueText" Text="—" FontSize="15"
                                                                           FontWeight="SemiBold" Margin="0,6,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <ProgressBar x:Name="CodexRemainingProgress" Height="4" Minimum="0" Maximum="100"
                                                                     Value="0" Margin="0,14,0,0" Foreground="{DynamicResource AccentBrush}"
                                                                     Background="{DynamicResource Surface.Pressed}" BorderThickness="0">
                                                            <ProgressBar.Template>
                                                                <ControlTemplate TargetType="ProgressBar">
                                                                    <Grid ClipToBounds="True">
                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                                                                        <Border x:Name="PART_Track" />
                                                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                                                                HorizontalAlignment="Left" CornerRadius="2" />
                                                                    </Grid>
                                                                </ControlTemplate>
                                                            </ProgressBar.Template>
                                                        </ProgressBar>
                                                    </StackPanel>
                                                </Border>

                                                <WrapPanel x:Name="CodexActionsPanel" HorizontalAlignment="Right" Margin="0,12,0,0">
                                                    <Button Content="安装/更新 Codex" MinWidth="126" Click="CodexInstallButton_OnClick" />
                                                    <Button Content="登录 Codex" MinWidth="104" Margin="8,0,0,8" Click="CodexLoginButton_OnClick" />
                                                    <Button Content="刷新额度" Style="{StaticResource SecondaryButton}" MinWidth="92" Margin="8,0,0,8" Click="CodexStatusButton_OnClick" />
                                                    <Button Content="打开配置" Style="{StaticResource SecondaryButton}" MinWidth="92" Margin="8,0,0,8" Click="CodexOpenConfigButton_OnClick" />
